{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "scout hook post-tool",
            "type": "command"
          }
        ],
        "matcher": "mcp__scout__.*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "scout hook pre-tool",
            "type": "command"
          }
        ],
        "matcher": "mcp__scout__.*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "scout hook session-end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "scout hook session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "scout hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "scout hook prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  }
}
